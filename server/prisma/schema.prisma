generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String      @id @default(uuid())
  username             String      @unique @default("admin_legacy")
  email                String?     @unique
  password             String
  nombre               String
  position             String?
  role                 Role        @default(EDITOR)
  department           Department?
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  logs                 EventLog[]
  quotations           Quotation[]
  tasks                Task[]
  collaboratedTasks    Task[]         @relation("TaskCollaborator")
  announcements        Announcement[]
}

model Announcement {
  id        String           @id @default(uuid())
  contenido String
  tipo      AnnouncementType @default(INFO)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id])
  createdAt DateTime         @default(now())
  deletedAt DateTime?
}

model Client {
  id                   String       @id @default(uuid())
  razon_social         String       @default("Sin Empresa")
  nit_id               String?      @unique
  documentType         DocumentType @default(NIT)
  isTaxExempt          Boolean      @default(false)
  responsable          String?
  direccion_fiscal     String?
  email                String?      @unique
  telefono             String?
  ciudad               String?
  referidoPor          String?
  observaciones        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  quotations           Quotation[]
  tasks                Task[]
}

model Inventory_Bodega {
  id                   String                @id @default(uuid())
  nombre               String
  claseA               Int                   @default(0)
  claseB               Int                   @default(0)
  claseC               Int                   @default(0)
  bodega               Bodega
  seccion              Seccion
  vlrUnitario          Float
  estado               ItemStatus            @default(ACTIVO)
  observaciones        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  commercial           Inventory_Commercial?
  compositions         Composition[]
}

model Inventory_Commercial {
  id               String           @id @default(uuid())
  nombre_comercial String
  claseA           Int              @default(0)
  claseB           Int              @default(0)
  claseC           Int              @default(0)
  valor_alquiler   Float            @default(0)
  isExternal       Boolean          @default(false)
  vendorCost       Float?
  estado           ItemStatus       @default(ACTIVO)
  bodegaId         String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  bodega           Inventory_Bodega? @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  quotationItems   QuotationItem[]
  compositions     Composition[]
}

model Quotation {
  id                   String             @id @default(uuid())
  nombre_evento        String
  tipo_evento          String?
  montaje_inicio       DateTime
  montaje_fin          DateTime
  evento_inicio        DateTime
  evento_fin           DateTime
  desmontaje_inicio    DateTime
  desmontaje_fin       DateTime
  ubicacion            String
  estado               QuotationStatus    @default(BORRADOR)
  vlrNeto              Float              @default(0)
  vlrTotal             Float              @default(0)
  bitacora             String?
  secureHash           String?            @unique
  purchaseOrderUrl     String?
  rejectionType        RejectionType?
  rejectionReason      String?
  clientId             String
  consultantId         String?
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  logs                 EventLog[]
  planning             PlanningStep?
  client               Client             @relation(fields: [clientId], references: [id])
  consultant           User?              @relation(fields: [consultantId], references: [id])
  items                QuotationItem[]
  services             QuotationService[]
}

model QuotationItem {
  id                   String                @id @default(uuid())
  quotationId          String
  inventoryId          String?
  customName           String?
  cantidad             Int
  precio_pactado       Float
  isExternal           Boolean               @default(false)
  vendorCost           Float?
  clase_asignada       String                @default("A")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  dias                 Int                   @default(1)
  precio_dia_adicional Float                 @default(0)
  inventory            Inventory_Commercial? @relation(fields: [inventoryId], references: [id])
  quotation            Quotation             @relation(fields: [quotationId], references: [id])
  compositions         Composition[]
}

model Composition {
  id              String                @id @default(uuid())
  quantity        Int                   @default(1)
  catalogItemId   String?
  quotationItemId String?
  warehouseItemId String
  catalogItem     Inventory_Commercial? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  quotationItem   QuotationItem?        @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  warehouseItem   Inventory_Bodega      @relation(fields: [warehouseItemId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model QuotationService {
  id                   String    @id @default(uuid())
  quotationId          String
  tipo                 String
  descripcion          String
  cantidad             Int       @default(1)
  precio_pactado       Float
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  dias                 Int       @default(1)
  precio_dia_adicional Float     @default(0)
  quotation            Quotation @relation(fields: [quotationId], references: [id])
}

model PlanningStep {
  id          String    @id @default(uuid())
  quotationId String    @unique
  cronograma  String?
  personal    Json?
  transporte  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model EventLog {
  id          String    @id @default(uuid())
  quotationId String
  userId      String?
  message     String
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
}

model Task {
  id                   String      @id @default(uuid())
  titulo               String
  status               TaskStatus  @default(PENDIENTE)
  isPriority           Boolean     @default(false)
  isImprorrogable      Boolean     @default(false)
  order                Int         @default(0)
  fechaLimite          DateTime
  comentarios          String?
  clientId             String?
  userId               String
  collaboratorId       String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  client               Client?      @relation(fields: [clientId], references: [id])
  user                 User         @relation(fields: [userId], references: [id])
  collaborator         User?        @relation("TaskCollaborator", fields: [collaboratorId], references: [id])
}

enum Role {
  ADMIN
  EDITOR
  CONSULTOR
}

enum DocumentType {
  NIT
  EIN
  OTHER
}

enum Department {
  ADMINISTRACION
  OPERATIVO
  DIRECCION_COMERCIAL
  LOGISTICA_TRANSPORTE
  COMERCIAL
  // Legacy values for migration compatibility
  DIRECCION
  COORDINACION
  ALMACEN
  LOGISTICA
}

enum Bodega {
  PRINCIPAL
  AUXILIAR
  CAPRIELLA
  SHERYLANDIA
}

enum Seccion {
  CUARTO_1
  CUARTO_2
  CUARTO_3
  CUARTO_4
  SALA
  OFICINA
  APTO
  COCINA
  PATIO
  HERRAMIENTAS
  GENERAL
}

enum QuotationStatus {
  BORRADOR
  ENVIADA
  APROBADA
  REVISION_SOLICITADA
  CANCELADA
  EJECUCION
  FINALIZADA
  RECHAZADA
  ACCEPTED_PENDING_OC
  CONFIRMED
}

enum ItemStatus {
  ACTIVO
  MANTENIMIENTO
  DANADO
}

enum RejectionType {
  CANTIDADES
  PRODUCTOS
  FECHAS
  LOGISTICA
  OTROS
  // Temporary for migration
  OTRO
  PRECIO
  CAMBIO_PLAN
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  REALIZADO
}

enum AnnouncementType {
  URGENTE
  LOGRO
  INFO
}
