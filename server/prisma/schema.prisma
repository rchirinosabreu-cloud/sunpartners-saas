// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum Department {
  DIRECCION
  COORDINACION
  ADMINISTRACION
  ALMACEN
  LOGISTICA
}

enum Class {
  CLASE_A
  CLASE_B
}

enum EventStatus {
  BORRADOR
  CONFIRMADO
  FINALIZADO
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  password       String
  nombre         String
  role           Role        @default(EDITOR)
  department     Department?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  deletedJustification String?
}

model InventoryItem {
  id              String       @id @default(uuid())
  nombre          String
  clase           Class
  bodega          String
  seccion         String
  existenciaTotal Int
  vlrUnitario     Float
  disponibles     Int          @default(0)
  enReparacion    Int          @default(0)
  observaciones   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  deletedJustification String?
  rentals         RentalItem[]
}

model Event {
  id             String       @id @default(uuid())
  nombre_cliente String
  fecha_inicio   DateTime
  fecha_fin      DateTime
  ubicacion      String
  estado         EventStatus  @default(BORRADOR)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedJustification String?
  items          RentalItem[]
}

model RentalItem {
  id          String        @id @default(uuid())
  event       Event         @relation(fields: [eventId], references: [id])
  eventId     String
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id])
  inventoryId String
  cantidad    Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedJustification String?
}
