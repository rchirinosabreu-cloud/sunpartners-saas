generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String      @id @default(uuid())
  email                String      @unique
  password             String
  nombre               String
  role                 Role        @default(EDITOR)
  department           Department?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
}

model InventoryItem {
  id                   String       @id @default(uuid())
  nombre               String
  claseA               Int          @default(0)
  claseB               Int          @default(0)
  claseC               Int          @default(0)
  bodega               Bodega
  seccion              Seccion
  vlrUnitario          Float
  observaciones        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  rentals              RentalItem[]
}

model Event {
  id                   String       @id @default(uuid())
  nombre_cliente       String
  fecha_inicio         DateTime
  fecha_fin            DateTime
  ubicacion            String
  estado               EventStatus  @default(BORRADOR)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  items                RentalItem[]
}

model RentalItem {
  id                   String        @id @default(uuid())
  eventId              String
  inventoryId          String
  cantidad             Int
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  event                Event         @relation(fields: [eventId], references: [id])
  inventory            InventoryItem @relation(fields: [inventoryId], references: [id])
}

enum Role {
  ADMIN
  EDITOR
}

enum Department {
  DIRECCION
  COORDINACION
  ADMINISTRACION
  ALMACEN
  LOGISTICA
}

enum Bodega {
  PRINCIPAL
  AUXILIAR
  CAPRIELLA
  SHERYLANDIA
}

enum Seccion {
  CUARTO_1
  CUARTO_2
  CUARTO_3
  CUARTO_4
  SALA
  OFICINA
  APTO
  COCINA
  PATIO
  HERRAMIENTAS
}

enum EventStatus {
  BORRADOR
  CONFIRMADO
  FINALIZADO
}
