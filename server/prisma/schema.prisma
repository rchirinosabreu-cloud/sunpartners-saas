// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum Department {
  DIRECCION
  COORDINACION
  ADMINISTRACION
  ALMACEN
  LOGISTICA
}

enum Bodega {
  PRINCIPAL
  AUXILIAR
  CAPRIELLA
  SHERYLANDIA
}

enum Seccion {
  CUARTO_1
  CUARTO_2
  CUARTO_3
  CUARTO_4
  SALA
  OFICINA
  APTO
  COCINA
  PATIO
  HERRAMIENTAS
  GENERAL
}

enum QuotationStatus {
  BORRADOR
  ENVIADA
  APROBADA
  REVISION_SOLICITADA
  CANCELADA
  EJECUCION
  FINALIZADA
  RECHAZADA
}

enum RejectionType {
  PRECIO
  FECHAS
  CAMBIO_PLAN
  OTRO
}

model User {
  id                   String      @id @default(uuid())
  email                String      @unique
  password             String
  nombre               String
  role                 Role        @default(EDITOR)
  department           Department?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  logs                 EventLog[]
}

model Client {
  id                   String      @id @default(uuid())
  empresa              String      @default("Sin Empresa")
  nit                  String?     @unique
  contactoPrincipal    String?
  cargo                String?
  direccion            String?
  ciudad               String?
  telefono             String?
  email                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  quotations           Quotation[]
}

model InventoryItem {
  id                   String       @id @default(uuid())
  nombre               String
  claseA               Int          @default(0)
  claseB               Int          @default(0)
  claseC               Int          @default(0)
  bodega               Bodega
  seccion              Seccion
  vlrUnitario          Float        // Valor del activo
  rentalPrice          Float        @default(0) // Precio de alquiler sugerido
  observaciones        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  items                QuotationItem[]
}

model Quotation {
  id                   String          @id @default(uuid())
  nombre_evento        String
  tipo_evento          String?
  fecha_inicio         DateTime
  fecha_fin            DateTime

  fecha_montaje_inicio     DateTime?
  fecha_montaje_fin        DateTime?
  fecha_desmontaje_inicio   DateTime?
  fecha_desmontaje_fin      DateTime?

  ubicacion            String
  estado               QuotationStatus @default(BORRADOR)
  vlrTotal             Float           @default(0)

  bitacora             String?         @db.Text
  secureHash           String?         @unique

  rejectionType        RejectionType?
  rejectionReason      String?

  clientId             String
  client               Client          @relation(fields: [clientId], references: [id])

  items                QuotationItem[]
  services             QuotationService[]
  planning             PlanningStep?
  logs                 EventLog[]

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
}

model QuotationItem {
  id               String        @id @default(uuid())
  quotationId      String
  quotation        Quotation     @relation(fields: [quotationId], references: [id])
  inventoryId      String
  inventory        InventoryItem @relation(fields: [inventoryId], references: [id])

  cantidad         Int
  precio_pactado   Float
  clase_asignada   String        @default("A") // "A" or "B"

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  deletedJustification String?
}

model QuotationService {
  id               String        @id @default(uuid())
  quotationId      String
  quotation        Quotation     @relation(fields: [quotationId], references: [id])

  tipo             String        // "Personal" or "Transporte"
  descripcion      String
  cantidad         Int           @default(1)
  precio_pactado   Float

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  deletedJustification String?
}

model PlanningStep {
  id           String    @id @default(uuid())
  quotationId  String    @unique
  quotation    Quotation @relation(fields: [quotationId], references: [id])

  cronograma   String?   @db.Text // Texto libre
  personal     Json?     // Structured table: [{nombre: string, rol: string, contacto: string}]
  transporte   Json?     // Structured table: [{vehiculo: string, placa: string, responsable: string}]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model EventLog {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id])
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])

  message      String
  createdAt    DateTime  @default(now())
}
