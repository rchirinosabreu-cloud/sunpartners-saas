generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String      @id @default(uuid())
  email                String      @unique
  password             String
  nombre               String
  role                 Role        @default(EDITOR)
  department           Department?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  logs                 EventLog[]
}

model Client {
  id                   String      @id @default(uuid())
  empresa              String      @default("Sin Empresa")
  nit                  String?     @unique
  contactoPrincipal    String?
  cargo                String?
  direccion            String?
  ciudad               String?
  telefono             String?
  email                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  quotations           Quotation[]
}

model Inventory_Bodega {
  id                   String                @id @default(uuid())
  nombre               String
  claseA               Int                   @default(0)
  claseB               Int                   @default(0)
  claseC               Int                   @default(0)
  bodega               Bodega
  seccion              Seccion
  vlrUnitario          Float
  estado               ItemStatus            @default(ACTIVO)
  observaciones        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  commercial           Inventory_Commercial?
}

model Inventory_Commercial {
  id               String           @id @default(uuid())
  nombre_comercial String
  claseA           Int              @default(0)
  claseB           Int              @default(0)
  claseC           Int              @default(0)
  valor_alquiler   Float            @default(0)
  estado           ItemStatus       @default(ACTIVO)
  bodegaId         String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  bodega           Inventory_Bodega @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  quotationItems   QuotationItem[]
}

model Quotation {
  id                   String             @id @default(uuid())
  nombre_evento        String
  tipo_evento          String?
  montaje_inicio       DateTime
  montaje_fin          DateTime
  evento_inicio        DateTime
  evento_fin           DateTime
  desmontaje_inicio    DateTime
  desmontaje_fin       DateTime
  ubicacion            String
  estado               QuotationStatus    @default(BORRADOR)
  vlrTotal             Float              @default(0)
  bitacora             String?
  secureHash           String?            @unique
  rejectionType        RejectionType?
  rejectionReason      String?
  clientId             String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  logs                 EventLog[]
  planning             PlanningStep?
  client               Client             @relation(fields: [clientId], references: [id])
  items                QuotationItem[]
  services             QuotationService[]
}

model QuotationItem {
  id                   String               @id @default(uuid())
  quotationId          String
  inventoryId          String
  cantidad             Int
  precio_pactado       Float
  clase_asignada       String               @default("A")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  dias                 Int                  @default(1)
  precio_dia_adicional Float                @default(0)
  inventory            Inventory_Commercial @relation(fields: [inventoryId], references: [id])
  quotation            Quotation            @relation(fields: [quotationId], references: [id])
}

model QuotationService {
  id                   String    @id @default(uuid())
  quotationId          String
  tipo                 String
  descripcion          String
  cantidad             Int       @default(1)
  precio_pactado       Float
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  deletedJustification String?
  dias                 Int       @default(1)
  precio_dia_adicional Float     @default(0)
  quotation            Quotation @relation(fields: [quotationId], references: [id])
}

model PlanningStep {
  id          String    @id @default(uuid())
  quotationId String    @unique
  cronograma  String?
  personal    Json?
  transporte  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model EventLog {
  id          String    @id @default(uuid())
  quotationId String
  userId      String?
  message     String
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  EDITOR
}

enum Department {
  DIRECCION
  COORDINACION
  ADMINISTRACION
  ALMACEN
  LOGISTICA
}

enum Bodega {
  PRINCIPAL
  AUXILIAR
  CAPRIELLA
  SHERYLANDIA
}

enum Seccion {
  CUARTO_1
  CUARTO_2
  CUARTO_3
  CUARTO_4
  SALA
  OFICINA
  APTO
  COCINA
  PATIO
  HERRAMIENTAS
  GENERAL
}

enum QuotationStatus {
  BORRADOR
  ENVIADA
  APROBADA
  REVISION_SOLICITADA
  CANCELADA
  EJECUCION
  FINALIZADA
  RECHAZADA
}

enum ItemStatus {
  ACTIVO
  MANTENIMIENTO
  DANADO
}

enum RejectionType {
  PRECIO
  FECHAS
  CAMBIO_PLAN
  OTRO
}
